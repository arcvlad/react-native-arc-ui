{
  "name": "react-native-arc-ui",
  "version": "1.0.0",
  "description": "Accessible, token-driven React Native UI components with UI-thread-first motion.",
  "author": {
    "name": "Vladimir Janjić",
    "url": "https://github.com/arcvlad"
  },
  "license": "MIT",
  "keywords": [
    "react-native",
    "react",
    "react-native-ui",
    "ui",
    "components",
    "component-library",
    "ui-library",
    "design-system",
    "reanimated",
    "expo",
    "accessibility",
    "typescript",
    "new-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcvlad/react-native-arc-ui.git"
  },
  "homepage": "https://github.com/arcvlad/react-native-arc-ui#readme",
  "bugs": {
    "url": "https://github.com/arcvlad/react-native-arc-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "react-native": "./dist/testing/index.js",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -w",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "validate": "npm run lint && npm run typecheck",
    "preparePublish": "npm run validate && npm pack --dry-run",
    "prepublishOnly": "npm run validate",
    "prepack": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-gesture-handler": ">=2.28.0",
    "react-native-reanimated": ">=3.19.0 <5.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-svg": "15.12.1",
    "typescript": "^5.4.0"
  }
}
